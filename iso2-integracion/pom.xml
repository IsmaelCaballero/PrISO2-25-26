<?xml version="1.0" encoding="UTF-8"?>
<!--
  iso2-integracion - CFG-06 - v1.1.0 (CDU19, spike de integraciones)
  Interoperabilidad con sistemas externos (IdP/SSO, HCE, RIS y PACS): dominio puro con
  politicas de simulacion de fallos y auditoria de hash encadenado EN MEMORIA, puertos de
  salida, adaptadores simulados, servicio que implementa InteropFacade y endpoints REST
  /api/integracion. El spike no persiste: no hay entidades JPA ni migracion Flyway.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.iso2</groupId>
    <artifactId>iso2-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iso2-integracion</artifactId>
  <!-- CFG-06 (D22/D23): sube MINOR de 1.0.0 a 1.1.0 al implementar CDU19. En la rama
       feature queda 1.1.0-SNAPSHOT; al fusionar a develop perdera el sufijo. -->
  <version>1.1.0-SNAPSHOT</version>
  <name>iso2-integracion</name>
  <properties>
    <!-- Puerta de calidad CFG-06 (D24/D27): cobertura de linea >= 70 % en el modulo.
         El spike simula los sistemas externos: no hay reglas de negocio de agenda que
         cubrir, pero si los modos de fallo (CAIDO/LENTO/TIEMPO SUPERADO), la huella de
         idempotencia y la cadena de auditoria, que van cubiertos por los tests. -->
    <jacoco.line.min>0.70</jacoco.line.min>
  </properties>

  <description>Integracion con IdP, HCE, RIS y PACS con spike de modos de fallo (CDU19, CFG-06).</description>
  <dependencies>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-common</artifactId>
      <version>${iso2.version}</version>
    </dependency>

    <!-- Web MVC: el modulo se ensambla en iso2-server-app. Sin JPA: el spike no persiste. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Usuario de auditoria desde SecurityContextHolder (JWT desde CDU17). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>

    <!-- Tests tecnicos del CDU19 (modos de fallo, huella de idempotencia y matriz TDOP);
         los TC humanos los ejecuta Ismael segun D28. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
