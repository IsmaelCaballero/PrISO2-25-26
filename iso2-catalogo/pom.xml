<?xml version="1.0" encoding="UTF-8"?>
<!--
  iso2-catalogo · CFG-01 · v1.1.0 (CDU16)
  Catalogo clinico y administrativo de pruebas de imagen: dominio (tipo de prueba +
  protocolo + politica), servicio que implementa PruebaCatalogoFacade con auditoria de
  hash encadenado, y endpoints REST /api/catalogo/pruebas.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.iso2</groupId>
    <artifactId>iso2-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iso2-catalogo</artifactId>
  <!-- CFG-01 (D22/D23): sube MINOR de 1.0.0 a 1.1.0 al implementar CDU16. En la rama
       feature queda 1.1.0-SNAPSHOT; al fusionar a develop perdera el sufijo. -->
  <version>1.1.0-SNAPSHOT</version>
  <name>iso2-catalogo</name>

  <properties>
    <!-- Puerta de calidad CFG-01 (D24/D27): cobertura de linea >= 60 % en el modulo. -->
    <jacoco.line.min>0.60</jacoco.line.min>
  </properties>

  <description>Catalogo clinico y administrativo de pruebas de imagen (CDU16, CFG-01).</description>

  <dependencies>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-common</artifactId>
      <version>${iso2.version}</version>
    </dependency>

    <!-- Persistencia JPA/Hibernate y web MVC: el modulo se ensambla en iso2-server-app. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Usuario de auditoria desde SecurityContextHolder (RBAC transitorio hasta CDU17). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>

    <!-- Tests tecnicos de humo/integracion (los TC humanos de CDU16 llegan segun D28). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
