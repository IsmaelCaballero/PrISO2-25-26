<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.iso2</groupId>
    <artifactId>iso2-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iso2-server-app</artifactId>
  <!-- Version de release train (D22): 0.1.0 en Iter0/CFG-00, 1.0.0 en CFG-21/R5. -->
  <version>0.1.0</version>
  <name>iso2-server-app</name>
  <description>Aplicacion servidora: API REST Spring Boot + JPA/H2. Ensambla los modulos de dominio.</description>

  <dependencies>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-common</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <!-- Los modulos de dominio se ensamblan aqui. En Iter0 solo existen como baseline
         (paquete + Javadoc); se iran anadiendo con su CDU correspondiente. -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-catalogo</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-seguridad</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-agendas</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-solicitudes</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-citas</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-integracion</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-pacientes</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-comunicacion</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-informes</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-reporting</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>