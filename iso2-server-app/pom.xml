<?xml version="1.0" encoding="UTF-8"?>
<!--
  iso2-server-app · CFG-05 · v0.1.5-SNAPSHOT (Iter5: D34 MySQL + CDU12)
  Ensambla el catalogo de pruebas (CDU16), la seguridad RBAC+JWT (CDU17), las agendas
  de medicos y tecnicos (CDU13) y las solicitudes de prueba (CDU06) sobre Spring Boot:
  API REST + JPA + Flyway (esquema versionado H2/MySQL) + cadena stateless con filtro JWT.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.iso2</groupId>
    <artifactId>iso2-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iso2-server-app</artifactId>
  <!-- Version de release train (D22): 0.1.0 en Iter0/CFG-00; 0.1.1 en Iter1/CFG-01;
       0.1.2 en Iter2/CFG-02; 0.1.3 en Iter3/CDU13; 0.1.4 en Iter4/CDU06;
       0.1.5-SNAPSHOT en la rama de Iter5 (D34 persistencia + CDU12 citas);
       1.0.0 en CFG-21/R5. -->
  <version>0.1.5-SNAPSHOT</version>
  <name>iso2-server-app</name>
  <description>Aplicacion servidora: API REST Spring Boot + JPA (H2 por defecto, MySQL con el perfil mysql, D34). Ensambla los modulos de dominio.</description>

  <properties>
    <!-- Puerta de calidad CFG-01 (D24/D27): cobertura de linea >= 60 % en la aplicacion. -->
    <jacoco.line.min>0.60</jacoco.line.min>
    <!-- Javadoc estricto: la aplicacion ya tiene clases publicas (config de seguridad). -->
    <javadoc.failOnError>true</javadoc.failOnError>
  </properties>

  <dependencies>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-common</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <!-- Unicos modulos de dominio con CDU hasta CFG-03: catalogo (CDU16), seguridad
         (CDU17) y agendas (CDU13). -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-catalogo</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-seguridad</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-agendas</artifactId>
      <version>${iso2.version}</version>
    </dependency>
    <!-- CDU06 (Iter4/CFG-04) mas el ripple de CDU12 (CFG-05): solicitudes sube a 1.2.0
         (marcarCitada/devolverACreada), asi que se fija literal y no con ${iso2.version}. -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-solicitudes</artifactId>
      <version>1.2.0-SNAPSHOT</version>
    </dependency>
    <!-- CDU12 (Iter5/CFG-05): citas pasa de baseline 1.0.0 a 1.1.0 y se ensambla ya con
         su implementacion de CitaFacade, no como baseline vacio. -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-citas</artifactId>
      <version>1.1.0-SNAPSHOT</version>
    </dependency>
    <!-- Resto de modulos: baseline 1.0.0 sin CDU en esta configuracion (matriz CFG-05);
         se iran subiendo a ${iso2.version} cuando les toque su CDU. -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-integracion</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-pacientes</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-comunicacion</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-informes</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-reporting</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- RBAC transitorio (hasta CDU17): Basic + usuarios en memoria con BCrypt. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Esquema de base de datos versionado con migraciones (D de trazabilidad). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- D34 (Iter5): soporte MySQL. El conector JDBC y el modulo de Flyway para
         MySQL (Flyway 10+ separa soporte por base de datos) viajan en runtime;
         la version la fija el BOM de Spring Boot. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- D34: Testcontainers levanta MySQL 8.4 efimero para validar migraciones y
         DAO contra el SGBD real; la version la fija el BOM de Spring Boot. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests de integracion cliente-servidor (CDU13, CFG-03): la prueba del server
         levanta la API real en RANDOM_PORT y la consume con los clientes HTTP reales
         de iso2-client-app (solo en test: en produccion el cliente es un proceso
         aparte, por eso el servidor no depende de el nunca). Version explicita del
         release train (0.1.5-SNAPSHOT en la rama de Iter5), no ${iso2.version}
         (eso es para los modulos de dominio). -->
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-client-app</artifactId>
      <version>0.1.5-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
