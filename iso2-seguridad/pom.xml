<?xml version="1.0" encoding="UTF-8"?>
<!--
  iso2-seguridad · CFG-02 · v1.1.0-SNAPSHOT (Iter2/CDU17)
  Autenticacion local y RBAC: usuarios persistidos (BCrypt + bloqueo por intentos
  fallidos), matriz de permisos para los 5 roles, token JWT HS256 con caducidad,
  filtro stateless y POST /api/auth/login. El secreto JWT solo via ISO2_JWT_SECRET.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.iso2</groupId>
    <artifactId>iso2-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iso2-seguridad</artifactId>
  <!-- CFG-02 (D22/D23): sube MINOR de 1.0.0 (baseline) a 1.1.0 al implementar CDU17.
       En la rama feature queda 1.1.0-SNAPSHOT; al fusionar a develop perdera el sufijo. -->
  <version>1.1.0-SNAPSHOT</version>
  <name>iso2-seguridad</name>
  <properties>
    <!-- Puerta de calidad CFG-02 (D24/D27): JwtUtils >= 90 % de linea (se mide en el
         informe JaCoCo del modulo); puerta del bundle completa >= 85 %. -->
    <jacoco.line.min>0.85</jacoco.line.min>
    <!-- Javadoc estricto: el modulo ya tiene clases publicas (CDU17). -->
    <javadoc.failOnError>true</javadoc.failOnError>
  </properties>

  <description>Roles, permisos (RBAC de 5 roles) y credenciales locales con JWT (CDU17, CFG-02).</description>

  <dependencies>
    <dependency>
      <groupId>es.uclm.iso2</groupId>
      <artifactId>iso2-common</artifactId>
      <version>${iso2.version}</version>
    </dependency>

    <!-- Persistencia JPA/Hibernate del usuario y web MVC para login/filtro:
         el modulo se ensambla en iso2-server-app. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- BCrypt (spring-security-crypto) y objetos de autenticacion del filtro. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>

    <!-- JWT (RFC 7519) HS256: api en compilacion, impl/serializador en ejecucion. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests tecnicos de humo/integracion (los TC humanos de CDU17 llegan segun D28). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
