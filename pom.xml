<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>es.uclm.iso2</groupId>
  <artifactId>iso2-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>iso2-parent</name>
  <description>
    Sistema Integral de Gestion de Radiodiagnostico e Imagen Medica (SESCAM) -
    agregador Maven del proyecto de la asignatura Ingenieria del Software II (UCLM).
    Dos aplicaciones: servidor Spring Boot (API + datos) y cliente JavaFX.
  </description>

  <!-- ===================================================================
       Versionado (D22): el agregador y los componentes de dominio siguen
       version BASELINE 1.0.0 (contratos) y suben MINOR por CDU (D23).
       Las aplicaciones siguen version de release train (D22): apps 0.1.0
       en Iter0/CFG-00. Las ramas feature usan -SNAPSHOT (Git Flow + D22).
       ==================================================================== -->
  <modules>
    <module>iso2-common</module>
    <module>iso2-catalogo</module>
    <module>iso2-seguridad</module>
    <module>iso2-agendas</module>
    <module>iso2-solicitudes</module>
    <module>iso2-citas</module>
    <module>iso2-integracion</module>
    <module>iso2-pacientes</module>
    <module>iso2-comunicacion</module>
    <module>iso2-informes</module>
    <module>iso2-reporting</module>
    <module>iso2-server-app</module>
    <module>iso2-client-app</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.5.4</spring-boot.version>
    <javafx.version>21.0.4</javafx.version>
    <archunit.version>1.3.0</archunit.version>
    <junit.version>5.11.3</junit.version>

    <!-- CFG-02 (Iter2/CDU17): iso2-seguridad sube a 1.1.0-SNAPSHOT en la rama feature
         (misma propiedad que common/catalogo, ya en 1.1.0); al fusionar a develop
         quedara 1.1.0 (D22/D23). Apps: release train 0.1.2-SNAPSHOT. -->
    <iso2.version>1.1.0-SNAPSHOT</iso2.version>
    <iso2-app.version>0.1.2-SNAPSHOT</iso2-app.version>

    <!-- CDU17 (CFG-02): libreria JWT estandar (RFC 7519) HS256 con validacion estricta. -->
    <jjwt.version>0.12.6</jjwt.version>

    <!-- Puerta JaCoCo por caracteristica (D24/D27): en Iter0 no hay codigo de
         producto todavia; el umbral se activa en CFG-01 con el primer modulo real. -->
    <jacoco.line.min>0.00</jacoco.line.min>
    <javadoc.failOnError>true</javadoc.failOnError>

    <!-- D34: version de Testcontainers. El BOM de Boot 3.5.4 gestiona 1.21.3, que
         habla la API 1.32 de Docker; Docker Engine 29 (Docker Desktop de Ismael)
         rechaza clientes por debajo de 1.40 y responde 400, asi que los tests de
         MySQL se saltaban. 1.21.4 es la serie 1.x compatible con Docker 29. OJO:
         como el BOM de Boot se importa (scope import) y no se hereda de
         spring-boot-starter-parent, la propiedad testcontainers.version NO surte
         efecto; hay que importar testcontainers-bom ANTES que spring-boot-dependencies. -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- D34: debe ir antes que spring-boot-dependencies para que gane 1.21.4. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <!-- Convencion Spring Boot: conserva los nombres de parametros en el .class
                 para que @RequestParam/@PathVariable deduzcan su nombre. -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.10.1</version>
          <configuration>
            <!-- En Iter0 los modulos de dominio son baseline sin clases publicas
                 (solo package-info): el Javadoc no debe romper el CI. Cada modulo
                 levanta javadoc.failOnError a true al anadir su primera clase. -->
            <failOnError>${javadoc.failOnError}</failOnError>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <!-- 0.8.15 (D34): desde 0.8.14 JaCoCo soporta los class files de Java 25
               (major 69). Con 0.8.12 el agente fallaba instrumentando clases del JDK
               y, de rebote, Testcontainers no detectaba Docker y saltaba los tests
               de MySQL. -->
          <version>0.8.15</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>0.0.8</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>informe-y-puerta</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>